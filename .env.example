# Optional: enables the live AI Doctor and AI Coach.
# Without a key, every session runs on the built-in rules engine (no cost, no network).
# Copy to .env.local for `npm run dev`, or set as environment variables on your host (e.g. Vercel).
# The key is only ever read on the server (api/ai.ts) — never shipped to the browser.
ANTHROPIC_API_KEY=

# Optional model override. Allowed: claude-sonnet-5 (default), claude-haiku-4-5-20251001, claude-opus-5-5
AI_DOCTOR_MODEL=claude-sonnet-5
